# 仅本地 Node 合成脚本读取；不要把真实凭据放进页面或提交到仓库。
# 新控制台推荐 API Key；填写这一项后不使用旧版两个鉴权字段。
DOUBAO_TTS_API_KEY=

# 旧控制台二选一：App ID + Access Token。
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=

# 官方 2.0 音色示例；需确认账户具有该音色/资源的调用权限。
DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_API_MODE=speech
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_SPEECH_RATE=-5
